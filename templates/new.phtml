<?php
/**
 * @var array{nickname: string, email: string} $values
 * @var array<string, string> $errors
 * */
?>

<h1>New user</h1>

<form action="/users" method="post">
    <p>
        <label>
            Nickname
            <input type="text" name="nickname" value="<?= htmlspecialchars($values['nickname']) ?>" />
        </label>
        <?php if (isset($errors['nickname'])) { ?>
            <span class="error"><?= htmlspecialchars($errors['nickname']) ?></span>
        <?php } ?>
    </p>
    <p>
        <label>
            Email
            <input type="email" name="email" value="<?= htmlspecialchars($values['email']) ?>" />
        </label>
        <?php if (isset($errors['email'])) { ?>
            <span class="error"><?= htmlspecialchars($errors['email']) ?></span>
        <?php } ?>
    </p>
    <input type="submit" value="Create" />
</form>

<p><a href="/users">Cancel</a></p>
