<?php
/**
 * @var array<int, array{id: int, nickname: string, email: string}> $users
 * @var string $term
 * @var array<string, string[]> $flash
 * @var array{id: int, nickname: string, email: string}|null $currentUser
 * */
?>

<?php if ($currentUser !== null) { ?>
    <p>Logged in as <?= htmlspecialchars($currentUser['email']) ?></p>
    <form action="/logout" method="post">
        <input type="submit" value="Log out" />
    </form>
<?php } else { ?>
    <p><a href="/login">Log in</a></p>
<?php } ?>

<?php foreach ($flash as $messages) { ?>
    <?php foreach ($messages as $message) { ?>
        <p><?= htmlspecialchars($message) ?></p>
    <?php } ?>
<?php } ?>

<h1>Users</h1>

<p><a href="/users/new">Add user</a></p>

<form action="/users" method="get">
    <label>
        <input type="search" name="term" value="<?= htmlspecialchars($term) ?>" />
    </label>
    <input type="submit" value="Search" />
</form>

<hr>

<?php if ($users === []) { ?>
    <p>No users found</p>
<?php } else { ?>
    <table>
        <thead>
        <tr>
            <th>Id</th>
            <th>Nickname</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        <?php foreach ($users as $user) { ?>
            <tr>
                <td><?= $user['id'] ?></td>
                <td><a href="/users/<?= $user['id'] ?>"><?= htmlspecialchars($user['nickname']) ?></a></td>
                <td><?= htmlspecialchars($user['email']) ?></td>
                <td>
                    <a href="/users/<?= $user['id'] ?>/edit">Edit</a>
                    <form action="/users/<?= $user['id'] ?>" method="post">
                        <input type="hidden" name="_METHOD" value="DELETE" />
                        <input type="submit" value="Delete" />
                    </form>
                </td>
            </tr>
        <?php } ?>
        </tbody>
    </table>
<?php } ?>
